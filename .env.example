# =============================================================================
# ChocoTi-Digital — Variables de Entorno de Configuración (.env.example)
# Chocolates Para Ti · Sucre, Bolivia
# =============================================================================
# Copie este archivo como '.env' para desarrollo local:
#   cp .env.example .env
#
# Para Render (https://chocoti-api.onrender.com):
#   Configure estas mismas variables en el panel:
#   Dashboard de Render -> chocoti-api -> Environment -> Add Environment Variable
# =============================================================================

# Puerto y Entorno
PORT=3001
NODE_ENV=development

# Clave secreta para firma de Tokens JWT (OBLIGATORIA)
# En Render genere una cadena aleatoria y segura de al menos 32 caracteres
JWT_SECRET=tu_clave_secreta_jwt_minimo_32_caracteres_cambiar_aqui
JWT_EXPIRES_IN=8h

# Ruta del archivo de base de datos SQLite
DB_PATH=database/chocoti.db

# URL base pública de la aplicación
# En local: http://localhost:3001
# En Render: https://chocoti-api.onrender.com
APP_BASE_URL=http://localhost:3001

# Orígenes permitidos para CORS (separados por coma)
# En Render: https://chocoti-api.onrender.com,http://localhost:3001,http://127.0.0.1:3001
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,https://chocoti-api.onrender.com

# Usuarios de prueba y datos semilla
SEED_DEMO_USERS=true
SEED_DEMO_PASSWORD=cambia_esta_contraseña_de_demo

# Integración externa para correos (API HTTPS: Resend o Brevo)
# NOTA RENDER: El plan gratuito de Render bloquea puertos salientes SMTP (25, 465, 587).
# Se utiliza API HTTPS REST (puerto 443). Si está vacío o no configurado,
# conmuta automáticamente a la 'bandeja_simulada' en SQLite para el Administrador.
EMAIL_API_KEY=
EMAIL_FROM=ventas@chocolatesti.bo

# Integración externa para WhatsApp (API Cloud Business / Simulado)
# Requiere cuenta Meta for Developers, WhatsApp Business Account (WABA) y teléfono verificado.
# Si está vacío o no configurado, opera con enlaces directos wa.me y conector simulado en logs.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_PHONE=59171163789

# PayPal (API REST Orders v2). sandbox = pruebas, live = real
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Tipo de cambio BOB → USD para facturar en PayPal (tasa oficial BCB)
TIPO_CAMBIO_USD=6.96

# Simulador de banco para el QR: true en desarrollo o demo académica, false en producción
ENABLE_BANK_SIMULATOR=true
